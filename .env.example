# Copy this file to .env. Never put secrets or API keys in VITE_ variables:
# everything prefixed with VITE_ is bundled into the public frontend code.

# true  = demo mode (built-in mock data, no backend needed)
# false = live mode (calls your backend; the paths below must then be set)
VITE_USE_MOCK=true

# Placeholder only. Replace with your backend base URL when you connect it.
VITE_API_BASE_URL=http://localhost:8080

# Live-mode endpoint paths. Left empty on purpose: set them to the real
# routes of your backend. The frontend does not assume any of them exist.
VITE_ANALYZE_PATH=
VITE_DOCUMENTS_PATH=
VITE_UPLOAD_PATH=
